<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="kpiCard" prefHeight="180" prefWidth="280" style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0.5, 0, 2);" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">
    
    <padding>
        <Insets bottom="25" left="25" right="25" top="25" />
    </padding>
    
    <spacing>15</spacing>
    
    <HBox alignment="CENTER_LEFT">
        <Label fx:id="iconLabel" style="-fx-font-size: 32; -fx-text-fill: #27AE60;" text="📈" />
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="moreBtn" style="-fx-background-color: transparent; -fx-text-fill: #7F8C8D; -fx-font-size: 20; -fx-cursor: hand; -fx-font-weight: bold;" text="⋯" />
    </HBox>
    
    <VBox spacing="5">
        <Label fx:id="titleLabel" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 16; -fx-text-fill: #2C3E50;" text="Total Revenue" />
        <Label fx:id="amharicLabel" style="-fx-font-family: 'Nyala'; -fx-font-size: 14; -fx-text-fill: #5D6D7E;" text="በጠቅላላ ገቢ" />
    </VBox>
    
    <Label fx:id="valueLabel" style="-fx-font-family: 'Segoe UI'; -fx-font-weight: bold; -fx-font-size: 32; -fx-text-fill: #27AE60;" text="ETB 0.0 M" />
    
    <HBox alignment="CENTER_LEFT" spacing="5">
        <Label fx:id="trendIcon" text="📈" />
        <Label fx:id="trendText" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 12; -fx-text-fill: #5D6D7E;" text="+12.5% from last month" />
    </HBox>
</VBox>
