<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Pagination?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="TMSController.TaxpayerManagementController">
    <padding>
        <Insets bottom="30" left="30" right="30" top="30" />
    </padding>
    
    <!-- Header -->
    <HBox>
        <VBox spacing="5">
            <Label style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #1A5276;" text="Taxpayer Management" />
            <Label style="-fx-font-size: 16px; -fx-text-fill: #5D6D7E;" text="Register, view, and manage taxpayer records" />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="newTaxpayerBtn" onAction="#handlerclicknewTaxpayerBtn" style="-fx-font-weight: bold; -fx-padding: 10 20; -fx-background-color: #27AE60; -fx-text-fill: white;" text="New Taxpayer" />
        <Button fx:id="backToDashboardBtn" onAction="#handlerclickbackToDashboardBtn" style="-fx-padding: 10 20; -fx-background-color: #FF0000; -fx-text-fill: white;" text="Back to Dashboard" />
    </HBox>
    
    <!-- Search and Filters -->
    <HBox spacing="15">
        <TextField fx:id="searchField" prefHeight="40" prefWidth="300" promptText="Search by TIN, Name, or Phone..." />
        <ComboBox fx:id="regionFilter" onAction="#handlerclickregionFilter" prefHeight="40" prefWidth="150" promptText="Select Region" />
        <ComboBox fx:id="categoryFilter" onAction="#handlerclickcategoryFilter" prefHeight="40" prefWidth="150" promptText="Select Category" />
        <ComboBox fx:id="statusFilter" onAction="#handlerclickstatusFilter" prefHeight="40" prefWidth="150" promptText="Select Status" />
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="searchBtn" onAction="#handlerclicksearchBtn" style="-fx-padding: 10 20; -fx-background-color: #2980B9; -fx-text-fill: white;" text="Search" />
        <Button fx:id="resetBtn" onAction="#handlerclickresetBtn" style="-fx-padding: 10 20; -fx-background-color: #7F8C8D; -fx-text-fill: white;" text="Reset" />
    </HBox>
    
    <!-- Statistics Cards -->
    <HBox spacing="20">
        <VBox prefWidth="180" spacing="10" style="-fx-padding: 15; -fx-background-color: white;">
            <Label style="-fx-font-size: 14px; -fx-text-fill: #5D6D7E;" text="Total Taxpayers" />
            <Label fx:id="totalTaxpayersLabel" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2980B9;" text="0" />
        </VBox>
        
        <VBox prefWidth="180" spacing="10" style="-fx-padding: 15; -fx-background-color: white;">
            <Label style="-fx-font-size: 14px; -fx-text-fill: #5D6D7E;" text="Active" />
            <Label fx:id="activeTaxpayersLabel" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #27AE60;" text="0" />
        </VBox>
        
        <VBox prefWidth="180" spacing="10" style="-fx-padding: 15; -fx-background-color: white;">
            <Label style="-fx-font-size: 14px; -fx-text-fill: #5D6D7E;" text="Inactive" />
            <Label fx:id="inactiveTaxpayersLabel" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #C0392B;" text="0" />
        </VBox>
        
        <VBox prefWidth="180" spacing="10" style="-fx-padding: 15; -fx-background-color: white;">
            <Label style="-fx-font-size: 14px; -fx-text-fill: #5D6D7E;" text="Compliance Rate" />
            <Label fx:id="complianceRateLabel" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #8E44AD;" text="0.0%" />
        </VBox>
    </HBox>
    
    <!-- Table View -->
    <TableView fx:id="taxpayerTable" style="-fx-pref-height: 400px;">
        <columns>
            <TableColumn fx:id="tinColumn" prefWidth="120" text="TIN" />
            <TableColumn fx:id="nameColumn" prefWidth="250" text="Taxpayer Name" />
            <TableColumn fx:id="categoryColumn" prefWidth="80" text="Category" />
            <TableColumn fx:id="regionColumn" prefWidth="120" text="Region" />
            <TableColumn fx:id="phoneColumn" prefWidth="120" text="Phone" />
            <TableColumn fx:id="statusColumn" prefWidth="100" text="Status" />
            <TableColumn fx:id="actionsColumn" prefWidth="200" text="Actions" />
        </columns>
    </TableView>
    
    <!-- Footer -->
    <HBox>
        <Label style="-fx-text-fill: #5D6D7E;" />
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="exportBtn" onAction="#handlerclickexportBtn" style="-fx-padding: 8 15; -fx-background-color: #27AE60; -fx-text-fill: white;" text="Export to Excel" />
        <Button fx:id="printBtn" onAction="#handlerclickprintBtn" style="-fx-padding: 8 15; -fx-background-color: #2980B9; -fx-text-fill: white;" text="Print List" />
        <Pagination fx:id="pagination" pageCount="10" />
    </HBox>
</VBox>