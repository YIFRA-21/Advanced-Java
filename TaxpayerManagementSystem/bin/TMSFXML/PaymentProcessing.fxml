<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/25" 
      xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="TMSController.PaymentProcessingController"
      fx:id="root"
      spacing="25" 
      style="-fx-background-color: #F4F6F7;">
    
    <padding>
        <Insets bottom="30" left="30" right="30" top="30" />
    </padding>
    
    <HBox alignment="CENTER_LEFT">
        <VBox spacing="5">
            <Label style="-fx-font-family: 'Segoe UI'; -fx-font-weight: bold; -fx-font-size: 28; -fx-text-fill: #1A5276;" 
                   text="Payment Processing" />
            <Label style="-fx-font-family: 'Segoe UI'; -fx-font-size: 16; -fx-text-fill: #5D6D7E;" 
                   text="Process and manage tax payments" />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="newPaymentBtn" onAction="#handlerclicknewPaymentBtn" 
               style="-fx-background-color: linear-gradient(to right, #27AE60, #219653); -fx-background-radius: 8; -fx-text-fill: white; -fx-cursor: hand; -fx-padding: 10 20 10 20; -fx-font-family: 'Segoe UI'; -fx-font-weight: bold; -fx-font-size: 16;" 
               text="💳 New Payment" />
        <Button fx:id="newTaxpayerBtn1" onAction="#handlerclicknewTaxpayerBtn1" 
               style="-fx-background-color: #FF0000; -fx-background-radius: 8; -fx-text-fill: white; -fx-cursor: hand; -fx-padding: 10 20 10 20; -fx-font-family: 'Segoe UI'; -fx-font-weight: bold; -fx-font-size: 16;" 
               text="Back to Dashboard" />
    </HBox>
    
    <!-- Statistics Cards -->
    <HBox alignment="CENTER" spacing="20">
        <!-- Total Payments Card -->
        <VBox prefHeight="120" prefWidth="200" spacing="10" 
              style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0.5, 0, 2);">
            <padding>
                <Insets bottom="20" left="20" right="20" top="20" />
            </padding>
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label style="-fx-font-size: 24;" text="💰" />
                <VBox spacing="2">
                    <Label style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14; -fx-text-fill: #5D6D7E;" 
                           text="Total Payments" />
                    <Label fx:id="totalPaymentsLabel" 
                           style="-fx-font-family: 'Segoe UI'; -fx-font-weight: bold; -fx-font-size: 22; -fx-text-fill: #27AE60;" 
                           text="ETB 0" />
                </VBox>
            </HBox>
        </VBox>
        
        <!-- Pending Payments Card -->
        <VBox prefHeight="120" prefWidth="200" spacing="10" 
              style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0.5, 0, 2);">
            <padding>
                <Insets bottom="20" left="20" right="20" top="20" />
            </padding>
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label style="-fx-font-size: 24;" text="⏳" />
                <VBox spacing="2">
                    <Label style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14; -fx-text-fill: #5D6D7E;" 
                           text="Pending" />
                    <Label fx:id="pendingPaymentsLabel" 
                           style="-fx-font-family: 'Segoe UI'; -fx-font-weight: bold; -fx-font-size: 22; -fx-text-fill: #E67E22;" 
                           text="0" />
                </VBox>
            </HBox>
        </VBox>
        
        <!-- Successful Payments Card -->
        <VBox prefHeight="120" prefWidth="200" spacing="10" 
              style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0.5, 0, 2);">
            <padding>
                <Insets bottom="20" left="20" right="20" top="20" />
            </padding>
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label style="-fx-font-size: 24;" text="✅" />
                <VBox spacing="2">
                    <Label style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14; -fx-text-fill: #5D6D7E;" 
                           text="Successful" />
                    <Label fx:id="successfulPaymentsLabel" 
                           style="-fx-font-family: 'Segoe UI'; -fx-font-weight: bold; -fx-font-size: 22; -fx-text-fill: #2980B9;" 
                           text="0" />
                </VBox>
            </HBox>
        </VBox>
        
        <!-- Failed Payments Card -->
        <VBox prefHeight="120" prefWidth="200" spacing="10" 
              style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0.5, 0, 2);">
            <padding>
                <Insets bottom="20" left="20" right="20" top="20" />
            </padding>
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label style="-fx-font-size: 24;" text="❌" />
                <VBox spacing="2">
                    <Label style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14; -fx-text-fill: #5D6D7E;" 
                           text="Failed" />
                    <Label fx:id="failedPaymentsLabel" 
                           style="-fx-font-family: 'Segoe UI'; -fx-font-weight: bold; -fx-font-size: 22; -fx-text-fill: #C0392B;" 
                           text="0" />
                </VBox>
            </HBox>
        </VBox>
    </HBox>
    
    <!-- Tab Pane -->
    <TabPane fx:id="paymentTabs" style="-fx-background-color: transparent; -fx-border-color: transparent;" 
             tabClosingPolicy="UNAVAILABLE">
        
        <!-- All Payments Tab -->
        <Tab fx:id="Allpaymentsbtn" text="All Payments">
            <VBox spacing="15">
                <padding>
                    <Insets bottom="15" left="15" right="15" top="15" />
                </padding>
                
                <!-- Filter Controls -->
                <HBox alignment="CENTER_LEFT" spacing="15">
                    <DatePicker fx:id="startDatePicker" onAction="#handlerclickstartDatePicker" 
                               promptText="Start Date" 
                               style="-fx-background-color: white; -fx-border-color: #BDC3C7; -fx-border-radius: 8;" />
                    <DatePicker fx:id="endDatePicker" onAction="#handlerclickendDatePicker" 
                               promptText="End Date" 
                               style="-fx-background-color: white; -fx-border-color: #BDC3C7; -fx-border-radius: 8;" />
                    <ComboBox fx:id="paymentMethodFilter" prefWidth="150" 
                             promptText="Payment Method" 
                             style="-fx-background-color: white; -fx-border-color: #BDC3C7; -fx-border-radius: 8;" />
                    <ComboBox fx:id="paymentStatusFilter" onAction="#handlerclickpaymentStatusFilter" 
                             prefWidth="150" promptText="Payment Status" 
                             style="-fx-background-color: white; -fx-border-color: #BDC3C7; -fx-border-radius: 8;" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button fx:id="filterbtn" onAction="#handlerclickfilterbtn" 
                           style="-fx-background-color: #2980B9; -fx-background-radius: 8; -fx-text-fill: white; -fx-cursor: hand; -fx-padding: 8 15 8 15;" 
                           text="Filter" />
                </HBox>
                
                <!-- Payments Table -->
                <TableView fx:id="paymentsTable" style="-fx-background-color: white; -fx-background-radius: 10;">
                    <columns>
                        <TableColumn fx:id="columonPaymentID" prefWidth="100" text="Payment ID" />
                        <TableColumn fx:id="columontin" prefWidth="120" text="TIN" />
                        <TableColumn fx:id="columonTxapayer" prefWidth="200" text="Taxpayer" />
                        <TableColumn fx:id="columonDate" prefWidth="100" text="Date" />
                        <TableColumn fx:id="columonAmount" prefWidth="120" text="Amount" />
                        <TableColumn fx:id="columonMethod" prefWidth="100" text="Method" />
                        <TableColumn fx:id="columonStatus" prefWidth="100" text="Status" />
                        <TableColumn fx:id="columonActions" prefWidth="150" text="Actions" />
                    </columns>
                </TableView>
            </VBox>
        </Tab>
        
        <!-- Quick Payment Tab -->
        <Tab fx:id="Quickpayment" text="Quick Payment">
            <VBox alignment="CENTER" spacing="20">
                <padding>
                    <Insets bottom="40" left="40" right="40" top="40" />
                </padding>
                
                <Label style="-fx-font-family: 'Segoe UI'; -fx-font-weight: bold; -fx-font-size: 24; -fx-text-fill: #1A5276;" 
                       text="Process Quick Payment" />
                
                <VBox prefWidth="500" spacing="15">
                    <!-- TIN Field -->
                    <VBox spacing="5">
                        <Label style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14; -fx-text-fill: #2C3E50;" 
                               text="Taxpayer TIN" />
                        <TextField fx:id="quickPaymentTin" prefHeight="40" promptText="Enter TIN" 
                                  style="-fx-background-color: white; -fx-border-color: #BDC3C7; -fx-border-radius: 8; -fx-border-width: 1.5; -fx-padding: 10;" />
                    </VBox>
                    
                    <!-- Amount Field -->
                    <VBox spacing="5">
                        <Label style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14; -fx-text-fill: #2C3E50;" 
                               text="Amount (ETB)" />
                        <TextField fx:id="quickPaymentAmount" prefHeight="40" promptText="Enter amount" 
                                  style="-fx-background-color: white; -fx-border-color: #BDC3C7; -fx-border-radius: 8; -fx-border-width: 1.5; -fx-padding: 10;" />
                    </VBox>
                    
                    <!-- Payment Method ComboBox -->
                    <VBox spacing="5">
                        <Label style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14; -fx-text-fill: #2C3E50;" 
                               text="Payment Method" />
                        <ComboBox fx:id="quickPaymentMethod" prefHeight="40" 
                                 style="-fx-background-color: white; -fx-border-color: #BDC3C7; -fx-border-radius: 8;" />
                    </VBox>
                    
                    <!-- Process Button -->
                    <Button fx:id="processQuickPaymentBtn" onAction="#handlerclickprocessQuickPaymentBtn" 
                           prefHeight="50" 
                           style="-fx-background-color: linear-gradient(to right, #27AE60, #219653); -fx-background-radius: 8; -fx-text-fill: white; -fx-cursor: hand; -fx-font-family: 'Segoe UI'; -fx-font-weight: bold; -fx-font-size: 16;" 
                           text="Process Payment" />
                </VBox>
            </VBox>
        </Tab>
    </TabPane>
</VBox>