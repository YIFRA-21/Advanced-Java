<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<VBox xmlns="http://javafx.com/javafx/17" 
      xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="TMSController.AdminController"
      spacing="20"
      style="-fx-background-color: #F5F7FA;">
    
    <padding>
        <Insets bottom="30" left="30" right="30" top="30" />
    </padding>
    
    <!-- Header Section -->
    <HBox alignment="CENTER_LEFT">
        <VBox spacing="5">
            <Label style="-fx-font-family: 'Segoe UI'; -fx-font-weight: bold; -fx-font-size: 28; -fx-text-fill: #1A5276;" 
                   text="Administration Panel" />
            <Label style="-fx-font-family: 'Segoe UI'; -fx-font-size: 16; -fx-text-fill: #5D6D7E;" 
                   text="System administration and configuration" />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
        <Label style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #C0392B; -fx-background-color: #FDEDEC; -fx-padding: 5 15 5 15; -fx-background-radius: 8;" 
               text="Admin Access Only" />
        <Button fx:id="backToDashboardBtn" onAction="#handleBackToDashboard" 
                style="-fx-background-color: #FF0000; -fx-background-radius: 8; -fx-text-fill: white; -fx-cursor: hand; -fx-padding: 10 20 10 20; -fx-font-family: 'Segoe UI'; -fx-font-weight: bold; -fx-font-size: 16;" 
                text="Back to Dashboard" />
    </HBox>
    
    <!-- Admin Panel Cards -->
    <HBox fx:id="administrationPanel" alignment="CENTER" spacing="20">
        <!-- User Management Card -->
        <VBox alignment="CENTER" prefHeight="180" prefWidth="200" spacing="15" 
              style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0.5, 0, 2);">
            <padding>
                <Insets bottom="20" left="20" right="20" top="20" />
            </padding>
            <Label style="-fx-font-size: 36;" text="👥" />
            <Label style="-fx-font-family: 'Segoe UI'; -fx-font-weight: bold; -fx-font-size: 16; -fx-text-fill: #2C3E50;" 
                   text="User Management" />
            <Label style="-fx-font-family: 'Segoe UI'; -fx-font-size: 12; -fx-text-fill: #7F8C8D;" 
                   text="Manage system users" />
            <Button fx:id="manageUsersBtn" onAction="#handleManageUsers" prefWidth="120" 
                    style="-fx-background-color: #2980B9; -fx-background-radius: 8; -fx-text-fill: white; -fx-cursor: hand; -fx-padding: 8 0 8 0;" 
                    text="Open" />
        </VBox>
        
        <!-- System Settings Card -->
        <VBox alignment="CENTER" prefHeight="180" prefWidth="200" spacing="15" 
              style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0.5, 0, 2);">
            <padding>
                <Insets bottom="20" left="20" right="20" top="20" />
            </padding>
            <Label style="-fx-font-size: 36;" text="⚙" />
            <Label style="-fx-font-family: 'Segoe UI'; -fx-font-weight: bold; -fx-font-size: 16; -fx-text-fill: #2C3E50;" 
                   text="System Settings" />
            <Label style="-fx-font-family: 'Segoe UI'; -fx-font-size: 12; -fx-text-fill: #7F8C8D;" 
                   text="Configure system parameters" />
            <Button fx:id="systemSettingsBtn" onAction="#handleSystemSettings" prefWidth="120" 
                    style="-fx-background-color: #8E44AD; -fx-background-radius: 8; -fx-text-fill: white; -fx-cursor: hand; -fx-padding: 8 0 8 0;" 
                    text="Open" />
        </VBox>
        
        <!-- Backup and Recovery Card -->
        <VBox alignment="CENTER" prefHeight="180" prefWidth="200" spacing="15" 
              style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0.5, 0, 2);">
            <padding>
                <Insets bottom="20" left="20" right="20" top="20" />
            </padding>
            <Label style="-fx-font-size: 36;" text="💾" />
            <Label style="-fx-font-family: 'Segoe UI'; -fx-font-weight: bold; -fx-font-size: 16; -fx-text-fill: #2C3E50;" 
                   text="Backup and Recovery" />
            <Label style="-fx-font-family: 'Segoe UI'; -fx-font-size: 12; -fx-text-fill: #7F8C8D;" 
                   text="System backup and restore" />
            <Button fx:id="backupRecoveryBtn" onAction="#handleBackupRecovery" prefWidth="120" 
                    style="-fx-background-color: #E67E22; -fx-background-radius: 8; -fx-text-fill: white; -fx-cursor: hand; -fx-padding: 8 0 8 0;" 
                    text="Open" />
        </VBox>
    </HBox>
    
    <!-- User Management Section -->
    <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 25;">
        <!-- Section Header -->
        <VBox spacing="5">
            <Text style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-fill: #2c3e50;" 
                  text="User Management" />
            <Text style="-fx-font-size: 14px; -fx-fill: #7f8c8d;" 
                  text="Add new users and manage existing user accounts" />
        </VBox>
        
        <!-- Add New User Form -->
        <VBox spacing="15">
            <Text style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-fill: #2c3e50;" 
                  text="Add New User" />
            
            <GridPane hgap="15" vgap="15">
                <columnConstraints>
                    <ColumnConstraints hgrow="NEVER" prefWidth="120" />
                    <ColumnConstraints hgrow="ALWAYS" />
                    <ColumnConstraints hgrow="NEVER" prefWidth="10" />
                    <ColumnConstraints hgrow="NEVER" prefWidth="120" />
                    <ColumnConstraints hgrow="ALWAYS" />
                </columnConstraints>
                <rowConstraints>
                    <RowConstraints />
                    <RowConstraints />
                    <RowConstraints />
                    <RowConstraints />
                    <RowConstraints />
                    <RowConstraints />
                </rowConstraints>
                
                <!-- Row 1: First Name & Last Name -->
                <Label text="First Name:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <TextField fx:id="firstNameField" promptText="Enter first name" 
                          GridPane.columnIndex="1" GridPane.rowIndex="0" />
                
                <Label text="Last Name:" GridPane.columnIndex="3" GridPane.rowIndex="0" />
                <TextField fx:id="lastNameField" promptText="Enter last name" 
                          GridPane.columnIndex="4" GridPane.rowIndex="0" />
                
                <!-- Row 2: Username & Email -->
                <Label text="Username:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <TextField fx:id="usernameField" promptText="Enter username" 
                          GridPane.columnIndex="1" GridPane.rowIndex="1" />
                
                <Label text="Email:" GridPane.columnIndex="3" GridPane.rowIndex="1" />
                <TextField fx:id="emailField" promptText="user@example.com" 
                          GridPane.columnIndex="4" GridPane.rowIndex="1" />
                
                <!-- Row 3: Password & Role -->
                <Label text="Password:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                <HBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="2">
                    <PasswordField fx:id="passwordField" prefWidth="200" 
                                  promptText="Enter password" />
                    <Button fx:id="showPasswordBtn" onAction="#handleShowPassword" 
                           prefWidth="40" style="-fx-background-color: #BDC3C7; -fx-border-radius: 4;" 
                           text="👁" />
                </HBox>
                
                <Label text="Role:" GridPane.columnIndex="3" GridPane.rowIndex="2" />
                <ComboBox fx:id="roleCombo" promptText="Select role" 
                         GridPane.columnIndex="4" GridPane.rowIndex="2" />
                
                <!-- Row 4: Confirm Password & Status -->
                <Label text="Confirm Password:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                <PasswordField fx:id="confirmPasswordField" promptText="Confirm password" 
                              GridPane.columnIndex="1" GridPane.rowIndex="3" />
                
                <Label text="Status:" GridPane.columnIndex="3" GridPane.rowIndex="3" />
                <ComboBox fx:id="statusCombo" promptText="Select status" 
                         GridPane.columnIndex="4" GridPane.rowIndex="3" />
                
                <!-- Row 5: Phone & Department -->
                <Label text="Phone Number:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                <TextField fx:id="phoneField" promptText="+251 XXX XXX XXX" 
                          GridPane.columnIndex="1" GridPane.rowIndex="4" />
                
                <Label text="Department:" GridPane.columnIndex="3" GridPane.rowIndex="4" />
                <ComboBox fx:id="departmentCombo" promptText="Select department" 
                         GridPane.columnIndex="4" GridPane.rowIndex="4" />
                
                <!-- Row 6: Form Buttons -->
                <HBox spacing="10" GridPane.columnIndex="1" GridPane.columnSpan="3" GridPane.rowIndex="5">
                    <Button fx:id="addUserBtn" onAction="#handleAddUser" 
                           style="-fx-background-color: #27AE60; -fx-background-radius: 8; -fx-text-fill: white; -fx-padding: 8 15;" 
                           text="Add User" />
                    <Button fx:id="clearFormBtn" onAction="#handleClearForm" 
                           style="-fx-background-color: #95a5a6; -fx-background-radius: 8; -fx-text-fill: white; -fx-padding: 8 15;" 
                           text="Clear Form" />
                    <Button fx:id="cancelBtn" onAction="#handleCancel" 
                           style="-fx-background-color: #e74c3c; -fx-background-radius: 8; -fx-text-fill: white; -fx-padding: 8 15;" 
                           text="Cancel" />
                </HBox>
            </GridPane>
        </VBox>
        
        <!-- User List Section -->
        <VBox spacing="15">
            <HBox alignment="CENTER_LEFT" spacing="15">
                <Text style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-fill: #2c3e50;" 
                      text="User List" />
                <Region HBox.hgrow="ALWAYS" />
                <TextField fx:id="userSearchField" prefHeight="40" prefWidth="300" 
                          promptText="Search users..." 
                          style="-fx-background-color: white; -fx-border-color: #BDC3C7; -fx-border-radius: 8;" />
                <Button fx:id="searchBtn" onAction="#handleSearch" 
                       style="-fx-background-color: #7F8C8D; -fx-background-radius: 8; -fx-text-fill: white; -fx-padding: 8 15;" 
                       text="Search" />
            </HBox>
            
            <!-- Users Table -->
            <TableView fx:id="usersTable" style="-fx-background-color: white;">
                <columns>
                    <TableColumn fx:id="userIdColumn" prefWidth="80" text="User ID" />
                    <TableColumn fx:id="usernameColumn" prefWidth="120" text="Username" />
                    <TableColumn fx:id="fullNameColumn" prefWidth="180" text="Full Name" />
                    <TableColumn fx:id="emailColumn" prefWidth="180" text="Email" />
                    <TableColumn fx:id="roleColumn" prefWidth="100" text="Role" />
                    <TableColumn fx:id="statusColumn" prefWidth="100" text="Status" />
                    <TableColumn fx:id="phoneColumn" prefWidth="120" text="Phone" />
                    <TableColumn fx:id="departmentColumn" prefWidth="120" text="Department" />
                    <TableColumn fx:id="actionsColumn" prefWidth="150" text="Actions" />
                </columns>
            </TableView>
        </VBox>
    </VBox>
    
    <!-- System Configuration Section -->
    <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 25;">
        <Label style="-fx-font-family: 'Segoe UI'; -fx-font-weight: bold; -fx-font-size: 20; -fx-text-fill: #1A5276;" 
               text="System Configuration" />
        
        <GridPane hgap="20" vgap="15">
            <columnConstraints>
                <ColumnConstraints prefWidth="200" />
                <ColumnConstraints prefWidth="300" />
                <ColumnConstraints prefWidth="200" />
                <ColumnConstraints prefWidth="300" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints />
                <RowConstraints />
            </rowConstraints>
            
            <Label style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14; -fx-text-fill: #2C3E50;" 
                   text="System Language:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <ComboBox fx:id="systemLanguageCombo" prefHeight="40" 
                     style="-fx-background-color: white; -fx-border-color: #BDC3C7; -fx-border-radius: 8;" 
                     GridPane.columnIndex="1" GridPane.rowIndex="0" />
            
            <Label style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14; -fx-text-fill: #2C3E50;" 
                   text="Default Currency:" GridPane.columnIndex="2" GridPane.rowIndex="0" />
            <ComboBox fx:id="currencyCombo" prefHeight="40" 
                     style="-fx-background-color: white; -fx-border-color: #BDC3C7; -fx-border-radius: 8;" 
                     GridPane.columnIndex="3" GridPane.rowIndex="0" />
            
            <Label style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14; -fx-text-fill: #2C3E50;" 
                   text="Tax Rate (Category A):" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <TextField fx:id="taxRateA" prefHeight="40" 
                      style="-fx-background-color: white; -fx-border-color: #BDC3C7; -fx-border-radius: 8; -fx-padding: 10;" 
                      GridPane.columnIndex="1" GridPane.rowIndex="1" />
            
            <Label style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14; -fx-text-fill: #2C3E50;" 
                   text="Tax Rate (Category B):" GridPane.columnIndex="2" GridPane.rowIndex="1" />
            <TextField fx:id="taxRateB" prefHeight="40" 
                      style="-fx-background-color: white; -fx-border-color: #BDC3C7; -fx-border-radius: 8; -fx-padding: 10;" 
                      GridPane.columnIndex="3" GridPane.rowIndex="1" />
        </GridPane>
        
        <HBox alignment="CENTER">
            <Button fx:id="saveConfigBtn" onAction="#handleSaveConfig" prefHeight="45" prefWidth="200" 
                   style="-fx-background-color: linear-gradient(to right, #27AE60, #219653); -fx-background-radius: 8; -fx-text-fill: white; -fx-font-family: 'Segoe UI'; -fx-font-weight: bold; -fx-font-size: 16;" 
                   text="Save Configuration" />
        </HBox>
    </VBox>
</VBox>