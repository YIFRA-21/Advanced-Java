<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Pagination?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.shape.Rectangle?>

<VBox xmlns="http://javafx.com/javafx/25" 
      xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="TMSController.AuditController"
      fx:id="root"
      spacing="25" 
      style="-fx-background-color: #F4F6F7;">
    
    <padding>
        <Insets bottom="30" left="30" right="30" top="30" />
    </padding>
    
    <!-- Header Section -->
    <HBox alignment="CENTER_LEFT">
        <VBox spacing="5">
            <Label style="-fx-font-family: 'Segoe UI'; -fx-font-weight: bold; -fx-font-size: 28; -fx-text-fill: #1A5276;" 
                   text="Audit and Activity Logs" />
            <Label style="-fx-font-family: 'Segoe UI'; -fx-font-size: 16; -fx-text-fill: #5D6D7E;" 
                   text="Monitor system activities and user actions" />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
        <HBox alignment="CENTER_RIGHT" spacing="15">
            <Button fx:id="exportAuditBtn" onAction="#handelerclickexportAuditBtn" 
                   style="-fx-background-color: #27AE60; -fx-background-radius: 8; -fx-text-fill: white; -fx-cursor: hand; -fx-padding: 10 20 10 20; -fx-font-family: 'Segoe UI'; -fx-font-weight: bold; -fx-font-size: 16;" 
                   text="📥 Export Logs" />
            <Button fx:id="clearOldLogsBtn" onAction="#handlerclickclearOldLogsBtn" 
                   style="-fx-background-color: #C0392B; -fx-background-radius: 8; -fx-text-fill: white; -fx-cursor: hand; -fx-padding: 10 20 10 20; -fx-font-family: 'Segoe UI'; -fx-font-weight: bold; -fx-font-size: 16;" 
                   text="🗑️ Clear Old Logs" />
            <Button fx:id="newTaxpayerBtn1" onAction="#handlerclicknewTaxpayerBtn1" 
                   style="-fx-background-color: #FF0000; -fx-background-radius: 8; -fx-text-fill: white; -fx-cursor: hand; -fx-padding: 10 20 10 20; -fx-font-family: 'Segoe UI'; -fx-font-weight: bold; -fx-font-size: 16;" 
                   text="Back to DashBoard" />
        </HBox>
    </HBox>
    
    <!-- Statistics Cards -->
    <HBox alignment="CENTER" spacing="20">
        <!-- Total Logs Card -->
        <VBox prefHeight="130" prefWidth="200" spacing="10" 
              style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0.5, 0, 2);">
            <padding>
                <Insets bottom="20" left="20" right="20" top="20" />
            </padding>
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Rectangle arcHeight="8" arcWidth="8" height="40" width="40">
                    <fill><Color fx:constant="DARKBLUE" /></fill>
                </Rectangle>
                <VBox spacing="2">
                    <Label style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14; -fx-text-fill: #5D6D7E;" 
                           text="Total Logs" />
                    <Label fx:id="totalLogsLabel" 
                           style="-fx-font-family: 'Segoe UI'; -fx-font-weight: bold; -fx-font-size: 22; -fx-text-fill: #2980B9;" 
                           text="0" />
                </VBox>
            </HBox>
        </VBox>
        
        <!-- Today's Activities Card -->
        <VBox prefHeight="130" prefWidth="200" spacing="10" 
              style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0.5, 0, 2);">
            <padding>
                <Insets bottom="20" left="20" right="20" top="20" />
            </padding>
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Rectangle arcHeight="8" arcWidth="8" height="40" width="40">
                    <fill><Color fx:constant="GREEN" /></fill>
                </Rectangle>
                <VBox spacing="2">
                    <Label style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14; -fx-text-fill: #5D6D7E;" 
                           text="Today's Activities" />
                    <Label fx:id="todaysLogsLabel" 
                           style="-fx-font-family: 'Segoe UI'; -fx-font-weight: bold; -fx-font-size: 22; -fx-text-fill: #27AE60;" 
                           text="0" />
                </VBox>
            </HBox>
        </VBox>
        
        <!-- Login Activities Card -->
        <VBox prefHeight="130" prefWidth="200" spacing="10" 
              style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0.5, 0, 2);">
            <padding>
                <Insets bottom="20" left="20" right="20" top="20" />
            </padding>
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Rectangle arcHeight="8" arcWidth="8" height="40" width="40">
                    <fill><Color fx:constant="ORANGE" /></fill>
                </Rectangle>
                <VBox spacing="2">
                    <Label style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14; -fx-text-fill: #5D6D7E;" 
                           text="Login Activities" />
                    <Label fx:id="loginLogsLabel" 
                           style="-fx-font-family: 'Segoe UI'; -fx-font-weight: bold; -fx-font-size: 22; -fx-text-fill: #E67E22;" 
                           text="0" />
                </VBox>
            </HBox>
        </VBox>
        
        <!-- Security Events Card -->
        <VBox prefHeight="130" prefWidth="200" spacing="10" 
              style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0.5, 0, 2);">
            <padding>
                <Insets bottom="20" left="20" right="20" top="20" />
            </padding>
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Rectangle arcHeight="8" arcWidth="8" height="40" width="40">
                    <fill><Color fx:constant="RED" /></fill>
                </Rectangle>
                <VBox spacing="2">
                    <Label style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14; -fx-text-fill: #5D6D7E;" 
                           text="Security Events" />
                    <Label fx:id="securityLogsLabel" 
                           style="-fx-font-family: 'Segoe UI'; -fx-font-weight: bold; -fx-font-size: 22; -fx-text-fill: #C0392B;" 
                           text="0" />
                </VBox>
            </HBox>
        </VBox>
    </HBox>
    
    <!-- Filter Section -->
    <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20;">
        <Label style="-fx-font-family: 'Segoe UI'; -fx-font-weight: bold; -fx-font-size: 18; -fx-text-fill: #1A5276;" 
               text="Filter Audit Logs" />
        
        <GridPane hgap="15" vgap="15">
            <columnConstraints>
                <ColumnConstraints prefWidth="150" />
                <ColumnConstraints prefWidth="300" />
                <ColumnConstraints prefWidth="150" />
                <ColumnConstraints prefWidth="300" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints />
                <RowConstraints />
            </rowConstraints>
            
            <!-- Date Range -->
            <Label style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14; -fx-text-fill: #2C3E50;" 
                   text="Date Range:" 
                   GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <HBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="0">
                <DatePicker fx:id="auditStartDate" onAction="#handlerclickauditStartDate" 
                           prefWidth="145" promptText="Start Date" 
                           style="-fx-background-color: white; -fx-border-color: #BDC3C7; -fx-border-radius: 8;" />
                <DatePicker fx:id="auditEndDate" prefWidth="145" promptText="End Date" 
                           style="-fx-background-color: white; -fx-border-color: #BDC3C7; -fx-border-radius: 8;" />
            </HBox>
            
            <!-- User -->
            <Label style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14; -fx-text-fill: #2C3E50;" 
                   text="User:" 
                   GridPane.columnIndex="2" GridPane.rowIndex="0" />
            <ComboBox fx:id="txtuserFilter" onAction="#handlerclicktxtuserFilter" 
                     prefHeight="40" prefWidth="300" promptText="Select User" 
                     style="-fx-background-color: white; -fx-border-color: #BDC3C7; -fx-border-radius: 8;" 
                     GridPane.columnIndex="3" GridPane.rowIndex="0" />
            
            <!-- Action Type -->
            <Label style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14; -fx-text-fill: #2C3E50;" 
                   text="Action Type:" 
                   GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <ComboBox fx:id="actionTypeFilter" onAction="#handlerclickactionTypeFilter" 
                     prefHeight="40" prefWidth="300" promptText="Select Action Type" 
                     style="-fx-background-color: white; -fx-border-color: #BDC3C7; -fx-border-radius: 8;" 
                     GridPane.columnIndex="1" GridPane.rowIndex="1" />
            
            <!-- IP Address -->
            <Label style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14; -fx-text-fill: #2C3E50;" 
                   text="IP Address:" 
                   GridPane.columnIndex="2" GridPane.rowIndex="1" />
            <TextField fx:id="txtipAddressFilter" prefHeight="40" promptText="Enter IP Address" 
                      style="-fx-background-color: white; -fx-border-color: #BDC3C7; -fx-border-radius: 8; -fx-padding: 10;" 
                      GridPane.columnIndex="3" GridPane.rowIndex="1" />
        </GridPane>
        
        <!-- Filter Buttons -->
        <HBox alignment="CENTER" spacing="15">
            <Button fx:id="applyFilterBtn" onAction="#handlerclickapplyFilterBtn" 
                   prefHeight="40" prefWidth="120" 
                   style="-fx-background-color: #2980B9; -fx-background-radius: 8; -fx-text-fill: white; -fx-cursor: hand; -fx-font-family: 'Segoe UI'; -fx-font-weight: bold; -fx-font-size: 14;" 
                   text="Apply Filters" />
            
            <Button fx:id="resetFilterBtn" onAction="#handlerclickresetFilterBtn" 
                   prefHeight="40" prefWidth="120" 
                   style="-fx-background-color: #7F8C8D; -fx-background-radius: 8; -fx-text-fill: white; -fx-cursor: hand; -fx-font-family: 'Segoe UI'; -fx-font-weight: bold; -fx-font-size: 14;" 
                   text="Reset Filters" />
        </HBox>
    </VBox>
    
    <!-- Audit Logs Table -->
    <VBox spacing="15">
        <HBox alignment="CENTER_LEFT">
            <Label style="-fx-font-family: 'Segoe UI'; -fx-font-weight: bold; -fx-font-size: 20; -fx-text-fill: #1A5276;" 
                   text="Audit Logs" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="logCountLabel" 
                   style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14; -fx-text-fill: #5D6D7E;" 
                   text="Showing 0 of 0 logs" />
        </HBox>
        
        <!-- Audit Table -->
        <TableView fx:id="auditTable" style="-fx-background-color: white; -fx-background-radius: 10;">
            <columns>
                <TableColumn fx:id="columonTimestamp" prefWidth="150" text="Timestamp" />
                <TableColumn fx:id="columonUser" prefWidth="120" text="User" />
                <TableColumn fx:id="columonAction" prefWidth="120" text="Action" />
                <TableColumn fx:id="columonModule" prefWidth="100" text="Module" />
                <TableColumn fx:id="columonDetails" prefWidth="250" text="Details" />
                <TableColumn fx:id="columonIpAdress" prefWidth="120" text="IP Address" />
                <TableColumn fx:id="columonstatus" prefWidth="80" text="Status" />
                <TableColumn prefWidth="80" text="View" />
            </columns>
        </TableView>
        
        <!-- Pagination Controls -->
        <HBox alignment="CENTER" spacing="20">
            <Button fx:id="refreshAuditBtn" onAction="#handlerclickrefreshAuditBtn" 
                   style="-fx-background-color: #27AE60; -fx-background-radius: 8; -fx-text-fill: white; -fx-cursor: hand; -fx-padding: 8 15 8 15; -fx-font-family: 'Segoe UI';" 
                   text="🔄 Refresh Logs" />
            
            <Region HBox.hgrow="ALWAYS" />
            
            <Pagination fx:id="auditPagination" maxPageIndicatorCount="5" 
                       pageCount="10" style="-fx-background-color: transparent;" />
        </HBox>
    </VBox>
</VBox>