<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="rootPane" style="-fx-background-color: #F4F6F7;" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/25" fx:controller="TMSController.DashboardController">
    
    <top>
        <HBox fx:id="topNav" spacing="20" style="-fx-background-color: #1A5276; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 10, 0.5, 0, 2);" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="15" left="30" right="30" top="15" />
            </padding>
            
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Rectangle arcHeight="10" arcWidth="10" fill="#27AE60" height="40" width="40" />
                <VBox spacing="2">
                    <Label fx:id="mainTitle" style="-fx-font-family: 'Nyala'; -fx-font-size: 20; -fx-text-fill: white;" text="የኢትዮጵያ ገቢዎች አስተዳደር" />
                    <Label style="-fx-font-family: 'Segoe UI'; -fx-font-size: 12; -fx-text-fill: #ECF0F1;" text="Tax Management System" />
                </VBox>
            </HBox>
            
            <Region HBox.hgrow="ALWAYS" />
            
            <HBox fx:id="userInfoBox" alignment="CENTER_RIGHT" spacing="15">
                <StackPane>
                    <Circle fill="#27AE60" radius="20" />
                    <Label fx:id="avatarText" style="-fx-font-family: 'Segoe UI'; -fx-font-weight: bold; -fx-font-size: 16; -fx-text-fill: white;" text="A" />
                </StackPane>
                <VBox spacing="2">
                    <Label fx:id="userNameLabel" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 16; -fx-text-fill: white;" text="Admin" />
                    <Label fx:id="userRoleLabel" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 12; -fx-text-fill: #BDC3C7;" text="ADMIN" />
                </VBox>
            </HBox>
        </HBox>
    </top>
    
    <left>
        <VBox fx:id="sidebar" prefWidth="280" style="-fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 2, 0);">
            <padding>
                <Insets bottom="20" top="20" />
            </padding>
            
            <VBox spacing="10" style="-fx-border-color: #ECF0F1; -fx-border-width: 0 0 2 0;">
                <padding>
                    <Insets bottom="30" left="20" right="20" />
                </padding>
                <Label style="-fx-font-family: 'Segoe UI'; -fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #5D6D7E;" text="Welcome," />
                <Label fx:id="sidebarUserName" style="-fx-font-family: 'Segoe UI'; -fx-font-weight: bold; -fx-font-size: 24; -fx-text-fill: #1A5276; -fx-wrap-text: true;" text="Admin" />
                <Label fx:id="dateLabel" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 12; -fx-text-fill: #5D6D7E;" text="Monday, January 1, 2025" />
            </VBox>
            
            <VBox fx:id="menuBox" spacing="5">
                <padding>
                    <Insets bottom="20" left="10" right="10" top="20" />
                </padding>
                <Button fx:id="dashboardBtn" onAction="#handlerclickdashboardBtn" prefHeight="55" prefWidth="250" style="-fx-background-color: transparent; -fx-text-fill: #2980B9; -fx-border-radius: 10; -fx-cursor: hand; -fx-padding: 0 0 0 20; -fx-font-family: 'Segoe UI'; -fx-font-size: 18; -fx-border-color: #2980B9;" text="📊 Dashboard" />
                <Button fx:id="taxpayerBtn" onAction="#handlerclicktaxpayerBtn" prefHeight="55" prefWidth="250" style="-fx-background-color: transparent; -fx-text-fill: #2980B9; -fx-border-radius: 10; -fx-cursor: hand; -fx-padding: 0 0 0 20; -fx-font-family: 'Segoe UI'; -fx-font-size: 18; -fx-border-color: #2980B9;" text="👥 Taxpayer" />
                <Button fx:id="assessmentBtn" onAction="#handlerclickassessmentBtn" prefHeight="55" prefWidth="250" style="-fx-background-color: transparent; -fx-text-fill: #2980B9; -fx-border-radius: 10; -fx-cursor: hand; -fx-padding: 0 0 0 20; -fx-font-family: 'Segoe UI'; -fx-font-size: 18; -fx-border-color: #2980B9;" text="📈 Assessment" />
                <Button fx:id="paymentBtn" onAction="#handlerclickpaymentBtn" prefHeight="55" prefWidth="250" style="-fx-background-color: transparent; -fx-text-fill: #2980B9; -fx-border-radius: 10; -fx-cursor: hand; -fx-padding: 0 0 0 20; -fx-font-family: 'Segoe UI'; -fx-font-size: 18; -fx-border-color: #2980B9;" text="💳 Payment" />
                <Button fx:id="reportsBtn" onAction="#handlerclickreportsBtn" prefHeight="55" prefWidth="250" style="-fx-background-color: transparent; -fx-text-fill: #2980B9; -fx-border-radius: 10; -fx-cursor: hand; -fx-padding: 0 0 0 20; -fx-font-family: 'Segoe UI'; -fx-font-size: 18; -fx-border-color: #2980B9;" text="📋 Reports" />
                <Button fx:id="auditBtn" onAction="#handlerclickauditBtn" prefHeight="55" prefWidth="250" style="-fx-background-color: transparent; -fx-text-fill: #2980B9; -fx-border-radius: 10; -fx-cursor: hand; -fx-padding: 0 0 0 20; -fx-font-family: 'Segoe UI'; -fx-font-size: 18; -fx-border-color: #2980B9;" text="🔍 Audit" />
                <Button fx:id="adminBtn" onAction="#handlerclickadminBtn" prefHeight="55" prefWidth="250" style="-fx-background-color: transparent; -fx-text-fill: #2980B9; -fx-border-radius: 10; -fx-cursor: hand; -fx-padding: 0 0 0 20; -fx-font-family: 'Segoe UI'; -fx-font-size: 18; -fx-border-color: #2980B9;" text="⚙ Admin" />
            </VBox>
            
            <VBox fx:id="quickActionsBox" spacing="15" style="-fx-border-color: #ECF0F1; -fx-border-width: 2 0 0 0;">
                <padding>
                    <Insets bottom="20" left="20" right="20" top="30" />
                </padding>
                <Label style="-fx-font-family: 'Segoe UI'; -fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="Quick Actions" />
                <Button fx:id="newTaxpayerBtn" onAction="#handlerclicknewTaxpayerBtn" prefHeight="45" prefWidth="240" style="-fx-background-color: white; -fx-border-color: #2980B9; -fx-border-radius: 8; -fx-text-fill: #2C3E50; -fx-cursor: hand; -fx-padding: 0 0 0 15; -fx-font-family: 'Segoe UI'; -fx-font-size: 16;" text="➕ Register New Taxpayer" />
                <Button fx:id="newPaymentBtn" onAction="#handlerclicknewPaymentBtn" prefHeight="45" prefWidth="240" style="-fx-background-color: white; -fx-border-color: #2980B9; -fx-border-radius: 8; -fx-text-fill: #2C3E50; -fx-cursor: hand; -fx-padding: 0 0 0 15; -fx-font-family: 'Segoe UI'; -fx-font-size: 16;" text="💰 Process Payment" />
                <Button fx:id="quickReportBtn" onAction="#handlerclickquickReportBtn" prefHeight="45" prefWidth="240" style="-fx-background-color: white; -fx-border-color: #2980B9; -fx-border-radius: 8; -fx-text-fill: #2C3E50; -fx-cursor: hand; -fx-padding: 0 0 0 15; -fx-font-family: 'Segoe UI'; -fx-font-size: 16;" text="📄 Generate Report" />
            </VBox>
            
            <Region VBox.vgrow="ALWAYS" />
            
            <Button fx:id="logoutBtn" onAction="#handlerclicklogoutBtn" prefHeight="55" prefWidth="250" style="-fx-background-color: #28a745; -fx-text-fill: #000000; -fx-border-radius: 10; -fx-cursor: hand; -fx-padding: 0 0 0 20; -fx-font-family: 'Segoe UI'; -fx-font-size: 25; -fx-border-color: #2980B9;" text="Logout">
                <font>
                    <Font name="System Bold" size="79.0" />
                </font>
            </Button>
        </VBox>
    </left>
    
    <center>
        <ScrollPane fx:id="mainContentScroll" fitToWidth="true" style="-fx-background-color: transparent; -fx-border-color: transparent;">
            <VBox fx:id="mainContent" spacing="25" style="-fx-background-color: #F4F6F7;">
                <padding>
                    <Insets bottom="30" left="30" right="30" top="30" />
                </padding>
                
                <!-- Header Section -->
                <HBox alignment="CENTER_LEFT">
                    <VBox spacing="5">
                        <Label style="-fx-font-family: 'Segoe UI'; -fx-font-weight: bold; -fx-font-size: 28; -fx-text-fill: #1A5276;" text="Executive Dashboard" />
                        <Label style="-fx-font-family: 'Segoe UI'; -fx-font-size: 16; -fx-text-fill: #5D6D7E;" text="Real-time overview of tax administration performance" />
                    </VBox>
                    <Region HBox.hgrow="ALWAYS" />
                    <Button fx:id="refreshBtn" onAction="#handlerclickrefreshBtn" style="-fx-background-color: white; -fx-border-color: #BDC3C7; -fx-border-radius: 8; -fx-text-fill: #2C3E50; -fx-cursor: hand; -fx-padding: 10 20 10 20; -fx-font-family: 'Segoe UI'; -fx-font-size: 16; -fx-border-color: #2980B9;" text="🔄 Refresh" />
                </HBox>
                
                <!-- KPI Cards Row 1 -->
                <HBox fx:id="kpiRow1" alignment="CENTER" spacing="20">
                    <!-- Total Revenue Card -->
                    <VBox prefHeight="180" prefWidth="280" spacing="15" style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0.5, 0, 2);">
                        <padding>
                            <Insets bottom="25" left="25" right="25" top="25" />
                        </padding>
                        
                        <HBox alignment="CENTER_LEFT">
                            <Label style="-fx-font-size: 32; -fx-text-fill: #27AE60;" text="💰" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Button style="-fx-background-color: transparent; -fx-text-fill: #7F8C8D; -fx-font-size: 20; -fx-cursor: hand; -fx-font-weight: bold;" text="⋯" />
                        </HBox>
                        
                        <VBox spacing="5">
                            <Label style="-fx-font-family: 'Segoe UI'; -fx-font-size: 16; -fx-text-fill: #2C3E50;" text="Total Revenue" />
                            <Label style="-fx-font-family: 'Nyala'; -fx-font-size: 14; -fx-text-fill: #5D6D7E;" text="በጠቅላላ ገቢ" />
                        </VBox>
                        
                        <Label fx:id="revenueValue" style="-fx-font-family: 'Segoe UI'; -fx-font-weight: bold; -fx-font-size: 32; -fx-text-fill: #27AE60;" text="ETB 0.0M" />
                        
                        <HBox alignment="CENTER_LEFT" spacing="5">
                            <Label text="📈" />
                            <Label style="-fx-font-family: 'Segoe UI'; -fx-font-size: 12; -fx-text-fill: #5D6D7E;" text="+0.0% from last month" />
                        </HBox>
                    </VBox>
                    
                    <!-- Active Taxpayers Card -->
                    <VBox prefHeight="180" prefWidth="280" spacing="15" style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0.5, 0, 2);">
                        <padding>
                            <Insets bottom="25" left="25" right="25" top="25" />
                        </padding>
                        
                        <HBox alignment="CENTER_LEFT">
                            <Label style="-fx-font-size: 32; -fx-text-fill: #2980B9;" text="👥" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Button style="-fx-background-color: transparent; -fx-text-fill: #7F8C8D; -fx-font-size: 20; -fx-cursor: hand; -fx-font-weight: bold;" text="⋯" />
                        </HBox>
                        
                        <VBox spacing="5">
                            <Label style="-fx-font-family: 'Segoe UI'; -fx-font-size: 16; -fx-text-fill: #2C3E50;" text="Active Taxpayers" />
                            <Label style="-fx-font-family: 'Nyala'; -fx-font-size: 14; -fx-text-fill: #5D6D7E;" text="ንቁ ታክስ ከፋዮች" />
                        </VBox>
                        
                        <Label fx:id="taxpayersValue" style="-fx-font-family: 'Segoe UI'; -fx-font-weight: bold; -fx-font-size: 32; -fx-text-fill: #2980B9;" text="0" />
                        
                        <HBox alignment="CENTER_LEFT" spacing="5">
                            <Label text="📈" />
                            <Label style="-fx-font-family: 'Segoe UI'; -fx-font-size: 12; -fx-text-fill: #5D6D7E;" text="+0.0% from last month" />
                        </HBox>
                    </VBox>
                    
                    <!-- Compliance Rate Card - FIXED: Removed problematic CSS -->
                    <VBox prefHeight="200" prefWidth="280" spacing="10" style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0.5, 0, 2);">
                        <padding>
                            <Insets bottom="20" left="25" right="25" top="20" />
                        </padding>
                        
                        <HBox alignment="CENTER_LEFT">
                            <Label style="-fx-font-size: 32; -fx-text-fill: #8E44AD;" text="✅" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Button style="-fx-background-color: transparent; -fx-text-fill: #7F8C8D; -fx-font-size: 20; -fx-cursor: hand; -fx-font-weight: bold;" text="⋯" />
                        </HBox>
                        
                        <VBox spacing="2">
                            <Label style="-fx-font-family: 'Segoe UI'; -fx-font-size: 16; -fx-text-fill: #2C3E50;" text="Compliance Rate" />
                            <Label style="-fx-font-family: 'Nyala'; -fx-font-size: 14; -fx-text-fill: #5D6D7E;" text="ማሟላት መጠን" />
                        </VBox>
                        
                        <Label fx:id="complianceValue" style="-fx-font-family: 'Segoe UI'; -fx-font-weight: bold; -fx-font-size: 32; -fx-text-fill: #8E44AD;" text="0.0%" />
                        
                        <!-- FIXED PROGRESS BAR (removed problematic style attribute) -->
                        <ProgressBar fx:id="complianceProgressBar" progress="0.0" style="-fx-accent: #8E44AD; -fx-pref-height: 8;" />
                        
                        <!-- COMPLIANCE TARGET LABEL -->
                        <Label fx:id="complianceTargetLabel" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 11; -fx-text-fill: #5D6D7E;" text="Current: 0.0% | Target: 85.0%" />
                        
                        <HBox alignment="CENTER_LEFT" spacing="5">
                            <Label text="📈" />
                            <Label style="-fx-font-family: 'Segoe UI'; -fx-font-size: 12; -fx-text-fill: #5D6D7E;" text="+0.0% from last month" />
                        </HBox>
                    </VBox>
                </HBox>
                
                <!-- KPI Cards Row 2 -->
                <HBox fx:id="kpiRow2" alignment="CENTER" spacing="20">
                    <!-- Pending Tasks Card -->
                    <VBox prefHeight="180" prefWidth="280" spacing="15" style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0.5, 0, 2);">
                        <padding>
                            <Insets bottom="25" left="25" right="25" top="25" />
                        </padding>
                        
                        <HBox alignment="CENTER_LEFT">
                            <Label style="-fx-font-size: 32; -fx-text-fill: #E67E22;" text="⏳" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Button style="-fx-background-color: transparent; -fx-text-fill: #7F8C8D; -fx-font-size: 20; -fx-cursor: hand; -fx-font-weight: bold;" text="⋯" />
                        </HBox>
                        
                        <VBox spacing="5">
                            <Label style="-fx-font-family: 'Segoe UI'; -fx-font-size: 16; -fx-text-fill: #2C3E50;" text="Pending Tasks" />
                            <Label style="-fx-font-family: 'Nyala'; -fx-font-size: 14; -fx-text-fill: #5D6D7E;" text="በጥበቃ ላይ ያሉ ተግባራት" />
                        </VBox>
                        
                        <Label fx:id="pendingTasksValue" style="-fx-font-family: 'Segoe UI'; -fx-font-weight: bold; -fx-font-size: 32; -fx-text-fill: #E67E22;" text="0" />
                        
                        <HBox alignment="CENTER_LEFT" spacing="5">
                            <Label text="📉" />
                            <Label style="-fx-font-family: 'Segoe UI'; -fx-font-size: 12; -fx-text-fill: #5D6D7E;" text="-0.0% from yesterday" />
                        </HBox>
                    </VBox>
                    
                    <!-- Total Collections Card -->
                    <VBox prefHeight="180" prefWidth="280" spacing="15" style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0.5, 0, 2);">
                        <padding>
                            <Insets bottom="25" left="25" right="25" top="25" />
                        </padding>
                        
                        <HBox alignment="CENTER_LEFT">
                            <Label style="-fx-font-size: 32; -fx-text-fill: #C0392B;" text="💵" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Button style="-fx-background-color: transparent; -fx-text-fill: #7F8C8D; -fx-font-size: 20; -fx-cursor: hand; -fx-font-weight: bold;" text="⋯" />
                        </HBox>
                        
                        <VBox spacing="5">
                            <Label style="-fx-font-family: 'Segoe UI'; -fx-font-size: 16; -fx-text-fill: #2C3E50;" text="Total Collections" />
                            <Label style="-fx-font-family: 'Nyala'; -fx-font-size: 14; -fx-text-fill: #5D6D7E;" text="በጠቅላላ ገቢዎች" />
                        </VBox>
                        
                        <Label fx:id="collectionsValue" style="-fx-font-family: 'Segoe UI'; -fx-font-weight: bold; -fx-font-size: 32; -fx-text-fill: #C0392B;" text="ETB 0.0M" />
                        
                        <HBox alignment="CENTER_LEFT" spacing="5">
                            <Label text="📈" />
                            <Label style="-fx-font-family: 'Segoe UI'; -fx-font-size: 12; -fx-text-fill: #5D6D7E;" text="+0.0% this quarter" />
                        </HBox>
                    </VBox>
                    
                    <!-- Audit Score Card -->
                    <VBox prefHeight="180" prefWidth="280" spacing="15" style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0.5, 0, 2);">
                        <padding>
                            <Insets bottom="25" left="25" right="25" top="25" />
                        </padding>
                        
                        <HBox alignment="CENTER_LEFT">
                            <Label style="-fx-font-size: 32; -fx-text-fill: #16A085;" text="📊" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Button style="-fx-background-color: transparent; -fx-text-fill: #7F8C8D; -fx-font-size: 20; -fx-cursor: hand; -fx-font-weight: bold;" text="⋯" />
                        </HBox>
                        
                        <VBox spacing="5">
                            <Label style="-fx-font-family: 'Segoe UI'; -fx-font-size: 16; -fx-text-fill: #2C3E50;" text="Audit Score" />
                            <Label style="-fx-font-family: 'Nyala'; -fx-font-size: 14; -fx-text-fill: #5D6D7E;" text="ኦዲት ነጥብ" />
                        </VBox>
                        
                        <Label fx:id="auditScoreValue" style="-fx-font-family: 'Segoe UI'; -fx-font-weight: bold; -fx-font-size: 32; -fx-text-fill: #16A085;" text="0.0/10" />
                        
                        <HBox alignment="CENTER_LEFT" spacing="5">
                            <Label text="📈" />
                            <Label style="-fx-font-family: 'Segoe UI'; -fx-font-size: 12; -fx-text-fill: #5D6D7E;" text="+0.0 points this month" />
                        </HBox>
                    </VBox>
                </HBox>
                
                <!-- Charts Section -->
                <VBox spacing="20">
                    <Label style="-fx-font-family: 'Segoe UI'; -fx-font-weight: bold; -fx-font-size: 22; -fx-text-fill: #1A5276;" text="Performance Analytics" />
                    
                    <HBox alignment="CENTER" spacing="20">
                        <!-- Revenue Bar Chart -->
                        <VBox prefHeight="350" prefWidth="500" spacing="10" style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0.5, 0, 2);">
                            <padding>
                                <Insets bottom="20" left="20" right="20" top="20" />
                            </padding>
                            
                            <Label style="-fx-font-family: 'Segoe UI'; -fx-font-weight: bold; -fx-font-size: 16; -fx-text-fill: #2C3E50;" text="Monthly Revenue (ETB Millions)" />
                            
                            <BarChart fx:id="revenueBarChart">
                                <xAxis>
                                    <CategoryAxis label="Month" />
                                </xAxis>
                                <yAxis>
                                    <NumberAxis label="Revenue (Millions)" lowerBound="0" />
                                </yAxis>
                            </BarChart>
                            
                            <HBox alignment="CENTER" spacing="10">
                                <Rectangle arcHeight="3" arcWidth="3" fill="#2980B9" height="15" width="15" />
                                <Label style="-fx-font-family: 'Segoe UI'; -fx-font-size: 12; -fx-text-fill: #5D6D7E;" text="Actual Revenue" />
                                
                                <Rectangle arcHeight="3" arcWidth="3" fill="#27AE60" height="15" width="15" />
                                <Label style="-fx-font-family: 'Segoe UI'; -fx-font-size: 12; -fx-text-fill: #5D6D7E;" text="Target Revenue" />
                            </HBox>
                        </VBox>
                        
                        <!-- Taxpayer Distribution Pie Chart -->
                        <VBox prefHeight="350" prefWidth="500" spacing="10" style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0.5, 0, 2);">
                            <padding>
                                <Insets bottom="20" left="20" right="20" top="20" />
                            </padding>
                            
                            <Label style="-fx-font-family: 'Segoe UI'; -fx-font-weight: bold; -fx-font-size: 16; -fx-text-fill: #2C3E50;" text="Taxpayer Distribution by Category" />
                            
                            <PieChart fx:id="taxpayerPieChart" />
                            
                            <HBox alignment="CENTER" spacing="10">
                                <Label style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="Total: 0 taxpayers" />
                            </HBox>
                        </VBox>
                    </HBox>
                    
                    <!-- Line Charts Row -->
                    <HBox alignment="CENTER" spacing="20">
                        <!-- Compliance Trend Line Chart -->
                        <VBox prefHeight="350" prefWidth="500" spacing="10" style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0.5, 0, 2);">
                            <padding>
                                <Insets bottom="20" left="20" right="20" top="20" />
                            </padding>
                            
                            <Label style="-fx-font-family: 'Segoe UI'; -fx-font-weight: bold; -fx-font-size: 16; -fx-text-fill: #2C3E50;" text="Compliance Rate Trend" />
                            
                            <LineChart fx:id="complianceLineChart">
                                <xAxis>
                                    <CategoryAxis label="Month" />
                                </xAxis>
                                <yAxis>
                                    <NumberAxis label="Compliance Rate (%)" lowerBound="0" upperBound="100" />
                                </yAxis>
                            </LineChart>
                            
                            <HBox alignment="CENTER" spacing="10">
                                <Label fx:id="complianceTrendLabel" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14; -fx-text-fill: #2C3E50;" text="Current: 0.0% | Target: 85.0%" />
                            </HBox>
                        </VBox>
                        
                        <!-- Regional Performance Chart -->
                        <VBox prefHeight="350" prefWidth="500" spacing="10" style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0.5, 0, 2);">
                            <padding>
                                <Insets bottom="20" left="20" right="20" top="20" />
                            </padding>
                            
                            <Label style="-fx-font-family: 'Segoe UI'; -fx-font-weight: bold; -fx-font-size: 16; -fx-text-fill: #2C3E50;" text="Regional Performance" />
                            
                            <BarChart fx:id="regionalBarChart">
                                <xAxis>
                                    <CategoryAxis label="Region" />
                                </xAxis>
                                <yAxis>
                                    <NumberAxis label="Collection (ETB Millions)" lowerBound="0" />
                                </yAxis>
                            </BarChart>
                            
                            <HBox alignment="CENTER" spacing="10">
                                <!-- TOP REGION LABEL -->
                                <Label fx:id="topRegionLabel" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #27AE60;" text="Top Region: N/A (ETB 0.0M)" />
                            </HBox>
                        </VBox>
                    </HBox>
                </VBox>
                
                <!-- Recent Activities & Alerts -->
                <HBox alignment="CENTER" spacing="20">
                    <!-- Recent Activities -->
                    <VBox prefHeight="300" prefWidth="500" spacing="15" style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0.5, 0, 2);">
                        <padding>
                            <Insets bottom="20" left="20" right="20" top="20" />
                        </padding>
                        
                        <HBox alignment="CENTER_LEFT">
                            <Label style="-fx-font-family: 'Segoe UI'; -fx-font-weight: bold; -fx-font-size: 18; -fx-text-fill: #2C3E50;" text="📋 Recent Activities" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Button style="-fx-background-color: transparent; -fx-text-fill: #2980B9; -fx-cursor: hand; -fx-font-family: 'Segoe UI'; -fx-font-size: 14;" text="View All" />
                        </HBox>
                        
                        <VBox fx:id="recentActivitiesBox" spacing="10">
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label style="-fx-font-size: 12;" text="🟢" />
                                <Label style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14; -fx-text-fill: #5D6D7E;" text="System initialized. No activities yet." />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label style="-fx-font-family: 'Segoe UI'; -fx-font-size: 12; -fx-text-fill: #95A5A6;" text="Just now" />
                            </HBox>
                        </VBox>
                    </VBox>
                    
                    <!-- System Alerts -->
                    <VBox prefHeight="300" prefWidth="500" spacing="15" style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0.5, 0, 2);">
                        <padding>
                            <Insets bottom="20" left="20" right="20" top="20" />
                        </padding>
                        
                        <HBox alignment="CENTER_LEFT">
                            <Label style="-fx-font-family: 'Segoe UI'; -fx-font-weight: bold; -fx-font-size: 18; -fx-text-fill: #2C3E50;" text="⚠️ System Alerts" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14; -fx-text-fill: #7F8C8D;" text="0 alerts" />
                        </HBox>
                        
                        <VBox fx:id="alertsBox" spacing="10">
                            <Label style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14; -fx-text-fill: #27AE60; -fx-font-weight: bold; -fx-background-color: #E8F8F5; -fx-padding: 10; -fx-background-radius: 8;" text="No active alerts. All systems are operational." />
                        </VBox>
                    </VBox>
                </HBox>
                
                <!-- Performance Metrics -->
                <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 25;">
                    <Label style="-fx-font-family: 'Segoe UI'; -fx-font-weight: bold; -fx-font-size: 20; -fx-text-fill: #1A5276;" text="Performance Metrics" />
                    
                    <GridPane hgap="20" vgap="15">
                        <columnConstraints>
                            <ColumnConstraints prefWidth="200" />
                            <ColumnConstraints prefWidth="300" />
                            <ColumnConstraints prefWidth="200" />
                            <ColumnConstraints prefWidth="300" />
                        </columnConstraints>
                        <rowConstraints>
                            <RowConstraints />
                            <RowConstraints />
                            <RowConstraints />
                        </rowConstraints>
                        
                        <Label style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14; -fx-text-fill: #2C3E50;" text="System Uptime:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                        <Label fx:id="uptimeLabel" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #27AE60;" text="0 days 0:00:00" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                        
                        <Label style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14; -fx-text-fill: #2C3E50;" text="Database Connections:" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                        <Label fx:id="dbConnectionsLabel" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #2980B9;" text="0 active" GridPane.columnIndex="3" GridPane.rowIndex="0" />
                        
                        <Label style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14; -fx-text-fill: #2C3E50;" text="CPU Usage:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                        <Label fx:id="cpuUsageLabel" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #8E44AD;" text="0.0%" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                        
                        <Label style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14; -fx-text-fill: #2C3E50;" text="Memory Usage:" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                        <Label fx:id="memoryUsageLabel" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #E67E22;" text="0.0%" GridPane.columnIndex="3" GridPane.rowIndex="1" />
                        
                        <Label style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14; -fx-text-fill: #2C3E50;" text="Active Users:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                        <Label fx:id="activeUsersLabel" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #C0392B;" text="0" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                        
                        <Label style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14; -fx-text-fill: #2C3E50;" text="Pending Notifications:" GridPane.columnIndex="2" GridPane.rowIndex="2" />
                        <Label fx:id="pendingNotificationsLabel" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #16A085;" text="0" GridPane.columnIndex="3" GridPane.rowIndex="2" />
                    </GridPane>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
    
    <bottom>
        <HBox fx:id="statusBar" spacing="20" style="-fx-background-color: white; -fx-border-color: #ECF0F1; -fx-border-width: 1 0 0 0;">
            <padding>
                <Insets bottom="10" left="30" right="30" top="10" />
            </padding>
            <Label style="-fx-font-family: 'Segoe UI'; -fx-font-size: 12; -fx-text-fill: #5D6D7E;" text="🟢 System Status: Online" />
            <Label fx:id="lastSyncLabel" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 12; -fx-text-fill: #5D6D7E;" text="Last sync: Never" />
            <Region HBox.hgrow="ALWAYS" />
            <Label style="-fx-font-family: 'Segoe UI'; -fx-font-size: 12; -fx-text-fill: #5D6D7E;" text="👤 Active users: 0" />
            <Label style="-fx-font-family: 'Segoe UI'; -fx-font-size: 12; -fx-text-fill: #5D6D7E;" text="💾 Database: Disconnected" />
        </HBox>
    </bottom>
</BorderPane>