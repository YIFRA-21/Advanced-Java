<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>

<StackPane fx:id="root" style="-fx-background-color: linear-gradient(to bottom right, #1a2a3a, #2C3E50);" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="TMSController.ForgotPasswordController">
    <HBox fx:id="passwordContainer" spacing="5"> <!-- ADD THIS LINE -->
    <PasswordField fx:id="hiddenPasswordField" prefHeight="46.0" prefWidth="350.0" 
                  promptText="Enter password" 
                  style="-fx-background-color: white; -fx-border-color: #BDC3C7; -fx-border-radius: 8; -fx-border-width: 1.5; -fx-padding: 12; -fx-font-size: 14; -fx-font-family: 'Segoe UI'; -fx-text-fill: #2C3E50;" />
    <Button fx:id="showPasswordBtn" prefHeight="40" prefWidth="45.0" 
            style="-fx-background-color: #BDC3C7; -fx-border-color: #95A5A6; -fx-border-radius: 6;" 
            text="👁" />
</HBox>
    <!-- Background Pattern -->
    <Rectangle fx:id="pattern" fill="TRANSPARENT" height="800" opacity="0.05" width="1200" />
    
    <!-- Forgot Password Card -->
    <VBox fx:id="forgotCard" alignment="CENTER" maxWidth="500" spacing="25" style="-fx-background-color: rgba(255, 255, 255, 0.98); -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 25, 0.5, 0, 5);">
        <padding>
            <Insets bottom="40" left="50" right="50" top="40" />
        </padding>
        
        <!-- Header Section -->
        <VBox alignment="CENTER" spacing="15">
            <Label style="-fx-font-family: 'Nyala'; -fx-font-size: 28; -fx-text-fill: #1A5276; -fx-wrap-text: true; -fx-alignment: CENTER;" text="የይለፍ ቃል ማስታወስያ" />
            <Label style="-fx-font-family: 'Segoe UI'; -fx-font-weight: bold; -fx-font-size: 20; -fx-text-fill: #2980B9;" text="Forgot Password" />
        </VBox>
        <Separator prefWidth="350" style="-fx-background-color: #ECF0F1;" />
        
        <!-- Status Label -->
        <Label fx:id="statusLabel" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14; -fx-text-fill: #666;" text="Enter your username or email to reset your password" />
        
        <!-- User Verification -->
        <VBox spacing="15">
            <VBox spacing="8">
                <Label style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14; -fx-text-fill: #2C3E50;" text="Username or Email:" />
                <TextField fx:id="usernameEmailField" prefHeight="40" prefWidth="350" promptText="Enter username or email" style="-fx-background-color: white; -fx-border-color: #BDC3C7; -fx-border-radius: 8; -fx-padding: 10; -fx-font-size: 14;" />
            </VBox>
            
            <!-- Security Question Section (Initially Hidden) -->
            <VBox fx:id="securityQuestionBox" managed="false" spacing="8" visible="false">
                <Label fx:id="securityQuestionLabel" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14; -fx-text-fill: #2C3E50;" text="Security Question:" />
                <TextField fx:id="securityAnswerField" prefHeight="40" prefWidth="350" promptText="Enter your security answer" style="-fx-background-color: white; -fx-border-color: #BDC3C7; -fx-border-radius: 8; -fx-padding: 10; -fx-font-size: 14;" />
            </VBox>
            
            <!-- New Password Section (Initially Hidden) -->
            <VBox spacing="8">
                <Label style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14; -fx-text-fill: #2C3E50;" text="New Password:" />
                <HBox spacing="5">
               <PasswordField fx:id="hiddenPasswordField" prefHeight="46.0" prefWidth="350.0" promptText="Enter password" style="-fx-background-color: white; -fx-border-color: #BDC3C7; -fx-border-radius: 8; -fx-border-width: 1.5; -fx-padding: 12; -fx-font-size: 14; -fx-font-family: 'Segoe UI'; -fx-text-fill: #2C3E50;" />
                    <Button fx:id="showPasswordBtn" prefHeight="40" prefWidth="45.0" style="-fx-background-color: #BDC3C7; -fx-border-color: #95A5A6; -fx-border-radius: 6;" text="👁" />
                </HBox>
            </VBox>
            
            <VBox spacing="8">
                <Label style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14; -fx-text-fill: #2C3E50;" text="Confirm Password:" />
            <TextField fx:id="usernameField" prefHeight="45" promptText="Enter confirm password" style="-fx-background-color: white; -fx-border-color: #BDC3C7; -fx-border-radius: 8; -fx-border-width: 1.5; -fx-padding: 12; -fx-font-size: 14; -fx-font-family: 'Segoe UI'; -fx-text-fill: #2C3E50;" />
            </VBox>
            
        </VBox>
        
        <!-- Action Buttons -->
        <HBox spacing="20">
            <Button fx:id="backButtonAdmin" prefHeight="40" prefWidth="150" style="-fx-background-color: #95A5A6; -fx-background-radius: 8; -fx-text-fill: white; -fx-font-family: 'Segoe UI'; -fx-font-size: 14; -fx-effect: dropshadow(gaussian, rgba(46, 204, 113, 0.3), 10, 0.5, 0, 2);" text="Back to Login" />
            <Button fx:id="resetPasswordBtn" prefHeight="40" prefWidth="150" style="-fx-background-color: linear-gradient(to right, #27AE60, #219653); -fx-background-radius: 8; -fx-text-fill: white; -fx-font-family: 'Segoe UI'; -fx-font-weight: bold; -fx-font-size: 14; -fx-effect: dropshadow(gaussian, rgba(46, 204, 113, 0.3), 10, 0.5, 0, 2);" text="Rest Password" />
        </HBox>
        
        <!-- Footer -->
        <VBox alignment="CENTER" spacing="10">
            <Label style="-fx-font-family: 'Segoe UI'; -fx-font-size: 11; -fx-text-fill: #95A5A6;" text="© 2025 Ethiopian Revenue Service" />
        </VBox>
    </VBox>
</StackPane>
